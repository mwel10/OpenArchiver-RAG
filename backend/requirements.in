# Directe afhankelijkheden. De vastgezette versies met hashes staan in
# requirements.txt, dat met pip-compile uit dit bestand wordt gegenereerd.
#
# starlette staat hier expliciet, hoewel het via fastapi binnenkomt. De
# gepinde 0.38.6 had veertien adviezen waarvan drie HIGH, en omdat het een
# transitieve afhankelijkheid was stond het niet in de dependency graph van de
# repo: Dependabot meldde nul waarschuwingen terwijl de kwetsbare laag er
# gewoon in zat. Expliciet pinnen maakt hem zichtbaar en controleerbaar.
fastapi==0.162.0
starlette==1.9.0
uvicorn[standard]==0.54.0
asyncpg==0.32.0
meilisearch==0.43.0
pydantic==2.14.1
# Binnen één minor van de server, zoals Qdrant voorschrijft. De server
# staat op 1.16.3. Vanaf client 1.16 bestaat search() niet meer; de code
# gebruikt query_points(), dat al sinds 1.10 werkt.
qdrant-client==1.16.2

# Deze twee blijven voorlopig staan: de sprong naar anthropic 2.x en openai 3.x
# is twee majors en brengt httpx2 mee, en hoort een eigen ronde met een eigen
# verificatie te krijgen.
anthropic==1.17.0
openai==1.54.0

# httpx blijft onder 0.28 zolang openai op 1.x staat. httpx heeft in 0.28 het
# argument `proxies` van Client.__init__ verwijderd, en openai 1.54.0 geeft het
# nog door: de applicatie start dan niet op met
# "TypeError: Client.__init__() got an unexpected keyword argument 'proxies'".
# Dat is hier gemeten, niet aangenomen. Deze grens kan weg zodra openai naar
# 3.x gaat; dat brengt sowieso httpx2 mee in plaats van httpx.
httpx<0.28
