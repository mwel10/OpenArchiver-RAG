# Copy to .env next to docker-compose.yml, fill in, then: chmod 600 .env
#
# .env is in .gitignore. Keep it that way. These values end up in `docker
# inspect` output either way, but there is no reason to also put them in a
# file that gets committed, copied and backed up.

# From: docker inspect OpenArchiver-MEILI | grep MEILI_MASTER_KEY
MEILISEARCH_MASTER_KEY=

# From: docker inspect OpenArchiver-DB | grep -E "POSTGRES_(DB|USER|PASSWORD)"
DATABASE_URL=postgresql://USER:PASSWORD@OpenArchiver-DB:5432/DATABASE

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Host path where OpenArchiver stores .eml files. From:
#   docker inspect OpenArchiver-WEB | grep -A3 '"Mounts"'
OPENARCHIVER_DATA=/path/to/openarchiver/data

# Uncomment to make a plain `docker compose up -d` include the Authelia layer,
# so you do not have to repeat the -f flags (and neither does any boot script).
#COMPOSE_FILE=docker-compose.yml:docker-compose.authelia.yml

# Shared secret between nginx and the backend, so the API is not
# reachable from every other container on the Docker network.
# Generate with: openssl rand -hex 32
# Put the same value in nginx/backend-secret.conf. Empty = no check.
BACKEND_SHARED_SECRET=

# API key for Qdrant, so the vector store is not readable and writable
# by every container on the Docker network. Generate with:
#   openssl rand -hex 32
# Empty = no key. Changing it requires recreating both qdrant and the backend.
QDRANT_API_KEY=

# Search-only key for Meilisearch. This app only searches, so it does not
# need the master key, which can delete indexes and mint new keys. Create
# one against your running Meilisearch:
#   curl -X POST http://localhost:7700/keys \
#     -H "Authorization: Bearer $MEILI_MASTER_KEY" \
#     -H 'Content-Type: application/json' \
#     -d '{"name":"email-rag search","actions":["search"],
#          "indexes":["*"],"expiresAt":null}'
# Leave empty to fall back to MEILISEARCH_MASTER_KEY.
MEILISEARCH_API_KEY=
